# ============================================
# GymSaaS - Variables de Entorno para Docker
# ============================================
# Copia este archivo como .env.docker y ajusta los valores
# cp .env.docker.example .env.docker

# --- PostgreSQL Local ---
DATABASE_URL=postgresql://gymsaas:gymsaas_secret_2024@postgres:5432/gym_saas?schema=public
POSTGRES_USER=gymsaas
POSTGRES_PASSWORD=gymsaas_secret_2024
POSTGRES_DB=gym_saas
DB_HOST=postgres
DB_PORT=5432

# --- JWT (cambiar en produccion) ---
JWT_ACCESS_SECRET=cambia_esto_por_un_secreto_seguro_access
JWT_REFRESH_SECRET=cambia_esto_por_un_secreto_seguro_refresh

# --- Backend ---
PORT=3000

# --- Email (Resend - opcional) ---
RESEND_API_KEY=re_xxxx
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- Gimnasio por defecto ---
DEFAULT_GIMNASIO_ID=

# --- Frontend ---
VITE_API_URL=/api
